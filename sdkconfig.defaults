# ESP32-S3 / Seeed XIAO ESP32-S3 Sense defaults.
# Applied on the first `idf.py set-target esp32s3` / `idf.py reconfigure`.

CONFIG_IDF_TARGET="esp32s3"

# The XIAO ESP32-S3 Sense uses an ESP32-S3R8 module: 8 MB octal PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# 4 MB flash on the JC4827W543, custom table with two OTA slots.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 1 kHz tick keeps 20 ms audio packet timing sane.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# First-boot Wi-Fi credentials (menuconfig -> "XIAO SIP Phone"). Written to NVS
# only when no configuration exists; stored in NVS in plain text.
# TEST VALUES ONLY - remove or replace before sharing or shipping this repo.
CONFIG_SIP_PHONE_WIFI_SSID=""
CONFIG_SIP_PHONE_WIFI_PASSWORD=""

# JC4827W543 hardware: the XIAO PDM/I2S and button wiring is not present and
# GPIO8/GPIO3 now belong to the touch controller.
CONFIG_SIP_PHONE_AUDIO_INMP441=y
CONFIG_SIP_PHONE_LEGACY_BUTTONS=n

# LVGL 9.3 (managed component). RGB565 into the NV3041A QSPI panel.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_LOG=y

# esp_sip_service/esp_rtc recommendations
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_LWIP_MAX_UDP_PCBS=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
